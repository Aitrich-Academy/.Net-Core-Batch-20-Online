@page "{id:int}"
@model StudentManagement.Pages.students.deleteModel
@{

    ViewData["Title"] = "Student Details";
    <form method="post">

    <div class="container my-4">
        <div class="card mx-auto" style="max-width: 500px;">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Student Details</h4>
                    <p> Are you sure you want to delete this employee?</p>

            </div>
            <div class="card-body">
                <p class="card-text"><strong>ID:</strong> @Model.mystudents.studentId</p>
                <p class="card-text"><strong>Name:</strong> @Model.mystudents.StudentName</p>
                <p class="card-text"><strong>Batch:</strong> @Model.mystudents.Batch</p>
            </div>
            <div class="card-footer text-end">

                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                <a asp-page="./index" class="btn btn-sm btn-secondary">Back to List</a>
            </div>
        </div>
    </div>

    </form>

   
}
