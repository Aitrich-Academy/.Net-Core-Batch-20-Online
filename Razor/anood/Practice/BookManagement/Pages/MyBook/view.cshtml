@page
@model BookManagement.Pages.MyBook.viewModel
@{
    ViewData["Title"] = "Book Details";


    <div class="container my-4">
        <div class="card mx-auto" style="max-width: 500px;">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Book Details</h4>
            </div>
            <div class="card-body">
                <p class="card-text"><strong>ID:</strong> @Model.mybook.BookId</p>
                <p class="card-text"><strong>Name:</strong> @Model.mybook.BookName</p>
                <p class="card-text"><strong>Author:</strong> @Model.mybook.Author</p>
                <p class="card-text"><strong>Category:</strong> @Model.mybook.Category</p>
                <p class="card-text"><strong>Prize:</strong> @Model.mybook.prize</p>
            </div>
            <div class="card-footer text-end">

                <a asp-page="./index" class="btn btn-sm btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
}
