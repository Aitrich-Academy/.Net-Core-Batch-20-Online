@page
@model LibrarySystem.Pages.Library.ViewModel
@{
	<h4>Welcome to books details</h4>



	<div class="d-flex justify-content-between align-items-center mb-2">
		<h5 class="mb-0">All Books</h5>
		<div>
 			<a asp-page="/Index" class="btn btn-danger btn-sm">LogOut</a>
		</div>
	</div>

	<table class="table table-striped table-bordered">
		<thead>
			<tr>
				<th>Book Id</th>
				<th>Title</th>
				<th>Author</th>
				 
			</tr>
		</thead>
		<tbody>
			@foreach (var mybook in Model.BookList)
			{
				<tr>
					<td>@mybook.Id</td>
					<td>@mybook.Title</td>
					<td>@mybook.Author</td>
					 
				</tr>
			}
		</tbody>
	</table>
}
