@page
@model EmployeeManagement.Pages.Employees.indexModel
@{
	<h4>Welcome to employee details</h4>

	<div class="d-flex justify-content-between align-items-center mb-2">
		<h5 class="mb-0">All Employees</h5>
		<a asp-page="/Employees/create" class="btn btn-primary btn-sm">Add New Employee</a>
	</div>

	<table class="table table-striped table-bordered">
		<thead>
			<tr>
				<th>Id</th>
				<th>Name</th>
				<th>Position</th>
				<th>Salary</th>
				<th>Department</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var myemp in Model.empList)
			{
				<tr>
					<td>@myemp.Id</td>
					<td>@myemp.Name</td>
					<td>@myemp.Position</td>
					<td>@myemp.Salary</td>
					<td>@myemp.Department</td>
					<td>
						<a asp-page="/Employees/view" asp-route-id="@myemp.Id" class="btn btn-success btn-sm">VIEW</a>
						<a asp-page="/Employees/edit" asp-route-id="@myemp.Id" class="btn btn-warning btn-sm">EDIT</a>
						<a asp-page="/Employees/delete" asp-route-id="@myemp.Id" class="btn btn-danger btn-sm">DELETE</a>
				</tr>



			}

		</tbody>

	</table>
}
