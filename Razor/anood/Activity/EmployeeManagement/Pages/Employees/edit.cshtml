@page
@model EmployeeManagement.Pages.Employees.editModel
@{
    <div class="container my-4">
        <div class="card mx-auto" style="max-width: 600px;">
            <div class="card-header bg-success text-white">
                <h4>Edit Employee Details</h4>
            </div>
            <div class="card-body">
                <form method="post">



                    <input asp-for="myemp.Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="myemp.Name" class="form-label"></label>
                        <input asp-for="myemp.Name" class="form-control" />
                        <span asp-validation-for="myemp.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="myemp.Position" class="form-label"></label>
                        <input asp-for="myemp.Position" class="form-control" />
                        <span asp-validation-for="myemp.Position" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="myemp.Salary" class="form-label"></label>
                        <input asp-for="myemp.Salary" class="form-control" />
                        <span asp-validation-for="myemp.Salary" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="myemp.Department" class="form-label"></label>
                        <input asp-for="myemp.Department" class="form-control" />
                        <span asp-validation-for="myemp.Department" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success">Update</button>
                    <a asp-page="./index" class="btn btn-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
}
