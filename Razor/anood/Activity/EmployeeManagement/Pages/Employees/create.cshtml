@page
@model EmployeeManagement.Pages.Employees.createModel
@{
	<h1>Add New Employee</h1>
	<form method="post">
		<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
		<div class="form-row">
			<div class="form-group col-md-6">
				<label asp-for="Employee.Name"></label>
				<input asp-for="Employee.Name" class="form-control" />
				<span asp-validation-for="Employee.Name" class="text-danger"></span>
			</div>
			<div class="form-group col-md-6">
				<label asp-for="Employee.Position"></label>
				<input asp-for="Employee.Position" class="form-control" />
				<span asp-validation-for="Employee.Position" class="text-danger"></span>
			</div>
			<div class="form-group col-md-6">
				<label asp-for="Employee.Salary"></label>
				<input asp-for="Employee.Salary" class="form-control" />
				<span asp-validation-for="Employee.Salary" class="text-danger"></span>
			</div>
			<div class="form-group col-md-6">
				<label asp-for="Employee.Department"></label>
				<input asp-for="Employee.Department" class="form-control" />
				<span asp-validation-for="Employee.Department" class="text-danger"></span>
			</div>
		</div>
		<button type="submit" class="btn btn-success btn-sm">Add Employee</button>
	</form>


	@section Scripts {
		<partial name="_ValidationScriptsPartial" />
	}
}
