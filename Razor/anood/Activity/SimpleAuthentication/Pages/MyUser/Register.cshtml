@page
@model SimpleAuthentication.Pages.MyUser.RegisterModel

    <h2>Register</h2>

    <form method="post">
        <label asp-for="NewUser.Username">Username:</label>
        <input asp-for="NewUser.Username" required />
        <span asp-validation-for="NewUser.Username" class="text-danger"></span>

        <label asp-for="NewUser.Password">Password:</label>
        <input asp-for="NewUser.Password" type="password" required />
        <span asp-validation-for="NewUser.Password" class="text-danger"></span>

        <!-- ✅ Place validation summary inside the form -->
        <div asp-validation-summary="All" class="text-danger"></div>

        <button type="submit">Register</button>
    </form>

    <a asp-page="/MyUser/Login">Already have an account? Login</a>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

}
