@page
@model JobPortal.Pages.MyJob.AddUserModel
@{
    ViewData["Title"] = "User Registration";

     
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="myuser.Fullname" class="form-label"></label>
                <input asp-for="myuser.Fullname" class="form-control" required  />
                <span asp-validation-for="myuser.Fullname" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="myuser.Username" class="form-label"></label>
                <input asp-for="myuser.Username" class="form-control" required  />
                <span asp-validation-for="myuser.Username" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="myuser.Password " class="form-label"></label>
                <input asp-for="myuser.Password " class="form-control" type="password" required />
                <span asp-validation-for="myuser.Password" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="myuser.Address" class="form-label"></label>
                <input asp-for="myuser.Address" class="form-control" />
                <span asp-validation-for="myuser.Address" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="myuser.Location" class="form-label"></label>
                <input asp-for="myuser.Location" class="form-control" />
                <span asp-validation-for="myuser.Location" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="myuser.PhoneNumber" class="form-label"></label>
                <input asp-for="myuser.PhoneNumber" class="form-control" />
                <span asp-validation-for="myuser.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="myuser.Email" class="form-label"></label>
                <input asp-for="myuser.Email" class="form-control" />
                <span asp-validation-for="myuser.Email" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="myuser.Gender" class="form-label"></label>
                <select asp-for="myuser.Gender" class="form-select">
                    <option value="">-- Select Gender --</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Other</option>
                </select>
                <span asp-validation-for="myuser.Gender" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="myuser.DOB" class="form-label"></label>
                <input asp-for="myuser.DOB" type="date" class="form-control" />
                <span asp-validation-for="myuser.DOB" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="myuser.Qualificaton" class="form-label"></label>
                <input asp-for="myuser.Qualificaton" class="form-control" />
                <span asp-validation-for="myuser.Qualificaton" class="text-danger"></span>
            </div>
            
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Register</button>
            <a asp-page="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>

    <a asp-page="/MyJob/Login">Already have an account? Login</a>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
}
