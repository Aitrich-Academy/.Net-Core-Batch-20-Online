@page
@model JobPortal.Pages.MyJob.ListJobsModel
 @{
    <h2>Job Listings</h2>
     
    // <div class="d-flex justify-content-between align-items-center mb-2">
    //     <h5 class="mb-0">All Jobs</h5>
    //     <div class="btn btn-sm btn-light">
    //         Welcome, <strong>@Model.Username</strong>!
    //         <a asp-page="/MyJob/Login"  class="btn btn-danger btn-sm"> Logout </a>
    //     </div>
    // </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">All Jobs</h5>

        <div class="btn-group btn-group-sm">
            <a asp-page="/MyJob/applied" class="btn btn-info">
                View My Applications
            </a>
            <span class="btn btn-light">
                Welcome, <strong>@Model.Username</strong>!
            </span>
            <a asp-page="/MyJob/Login" class="btn btn-danger">Logout</a>
        </div>
    </div>


    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Job Title</th>
                <th>Company</th>
                <th>Location</th>
                <th>Employment Type</th>
                <th>Salary Range</th>
                <th>Job Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.JobPosts)
            {
                <tr>
                    <td>@job.JobTitle</td>
                    <td>@job.Company</td>
                    <td>@job.Location</td>
                    <td>@job.EmploymentType</td>
                    <td>@job.SalaryRange</td>
                    <td>@job.JobDescription </td>
                    <td>
                     

                            <a asp-page="/MyJob/view" asp-route-id="@job.Id" class= "btn btn-warning btn-sm" > Apply </a>
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
}
