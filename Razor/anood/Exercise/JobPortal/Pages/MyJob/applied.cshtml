@page
@model JobPortal.Pages.MyJob.appliedModel
@{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5>My Applications</h5>
        <a asp-page="/MyJob/ListJobs" class="btn btn-secondary btn-sm">← Back to Jobs</a>
    </div>

    @if (!Model.AppliedJobs.Any())
    {
        <div class="alert alert-info">You haven't applied to any jobs yet.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Applied Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var aj in Model.AppliedJobs)
                {
                    <tr>
                        <td>@aj.Title</td>
                        <td>@aj.Company</td>
                        <td>@aj.Location</td>
                        <td>@aj.AppliedDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
