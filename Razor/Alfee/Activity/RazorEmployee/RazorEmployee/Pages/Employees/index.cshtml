@page
@model RazorEmployee.Pages.Employees.indexModel
@{
    <h2 class="text-center text-primary mb-4">Employee List</h2>

<div class="container">
    <!-- Search Form -->
        <form method="get" class="mb-4">
            <div class="form-group text-center">
                <input type="text" name="SearchTerm" value="@Model.SearchTerm"
                       class="form-control w-50 mx-auto mb-2"
                       placeholder="Search by name or position..." />
                <div class="mt-2">
                    <button type="submit" class="btn btn-primary mr-2">Search</button>
                    <a asp-page="Index" class="btn btn-secondary">Clear</a>
                </div>
            </div>
        </form>
    <!-- Add Employee Button -->
    <div class="text-right mb-3">
        <a asp-page="Create" class="btn btn-success">+ Add Employee</a>
    </div>

        <!-- Employee Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover shadow-sm">
                <thead class="thead-dark">
                    <tr>
                        <th>Name</th>
                        <th>Position</th>
                        <th>Salary</th>
                        <th>Department</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.EmployeeList)
                    {
                        <tr>
                            <td>@employee.Name</td>
                            <td>@employee.Position</td>
                            <td>@employee.Salary.ToString("N2")</td>
                            <td>@employee.Department</td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-warning mr-2">Edit</a>
                                <a asp-page="delete" asp-route-id="@employee.Id" class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

}
