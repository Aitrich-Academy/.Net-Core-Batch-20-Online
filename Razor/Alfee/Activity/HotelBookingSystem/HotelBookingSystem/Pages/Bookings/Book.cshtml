@page "{roomId:int}"
@model HotelBookingSystem.Pages.Bookings.BookModel
@{
	ViewData["Title"] = "Book Room";
}

<div class="container mt-4">
    <h2>Book Room @Model.Room?.RoomNumber (@Model.Room?.RoomType)</h2>

    <form method="post" class="mt-3">
        <div asp-validation-summary="All" class="text-danger"></div>

        <input type="hidden" asp-for="Booking.RoomId" />

        <div class="form-group">
            <label asp-for="Booking.CustomerName"></label>
            <input asp-for="Booking.CustomerName" class="form-control" />
            <span asp-validation-for="Booking.CustomerName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Booking.CheckInDate"></label>
            <input asp-for="Booking.CheckInDate" type="date" class="form-control" />
            <span asp-validation-for="Booking.CheckInDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Booking.CheckOutDate"></label>
            <input asp-for="Booking.CheckOutDate" type="date" class="form-control" />
            <span asp-validation-for="Booking.CheckOutDate" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Confirm Booking</button>
    </form>
</div>

@section Scripts 
{
    <partial name="_ValidationScriptsPartial" />
}