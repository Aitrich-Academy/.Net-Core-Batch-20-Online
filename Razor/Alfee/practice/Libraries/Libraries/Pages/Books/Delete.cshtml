@page
@model Libraries.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this student?</h4>

    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Book.Title</dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Model.Book.Author</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Book.Price</dd>

        <dt class="col-sm-2">Date of Publish</dt>
        <dd class="col-sm-10">@Model.Book.DateofPublish</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Book.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

