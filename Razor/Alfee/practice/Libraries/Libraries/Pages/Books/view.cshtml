@page
@model Libraries.Pages.Books.viewModel
@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-5">
    <h2 class="mb-4">Book Details</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Name: @Model.Book.Title</h5>
            <p class="card-text"><strong>Title:</strong> @Model.Book.Title</p>
            <p class="card-text"><strong>Author:</strong> @Model.Book.Author</p>
            <p class="card-text"><strong>Price:</strong> @Model.Book.Price</p>
            <p class="card-text"><strong>Price:</strong> @Model.Book.DateofPublish</p>

            <a asp-page="/Books/index" class="btn btn-secondary mt-3">Back to List</a>
        </div>
    </div>
</div>

