@page
@model College.Pages.students.DeleteModel
@{
	ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>

<div class="alert alert-danger">
    <h4>Are you sure you want to delete this student?</h4>

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Students.Name</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Students.Age</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Students.Course</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Students.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
