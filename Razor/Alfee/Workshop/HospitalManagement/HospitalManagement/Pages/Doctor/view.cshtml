@page "{id:int}"
@model HospitalManagement.Pages.Doctor.viewModel
@{
	ViewData["Title"] = "Doctor Details";
}


@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="container d-flex justify-content-center pt-5">
    <div class="card shadow-lg border-0 rounded-4" style="max-width: 500px; width: 100%;">
        <div class="card-header bg-primary text-white text-center rounded-top-4">
            <h4 class="mb-0">🧑‍⚕️ Doctor Profile</h4>
        </div>
        <div class="card-body">
            <p><strong>🧔 Name:</strong> Dr Radhi Krishna</p>
            <p><strong>🩺 Specialization:</strong> Neurologist</p>
            <p><strong>⏰ Available Time:</strong> 3:30 P.M - 7:00 P.M</p>
            <p><strong>📞 Contact:</strong> 3456789012</p>
        </div>
        <div class="card-footer text-end bg-light rounded-bottom-4">
            <a asp-page="Index" class="btn btn-outline-secondary me-2">Back</a>
            <a asp-page="./View" asp-route-id="@Model.Doctor.Id" asp-route-bookNow="true" class="btn btn-success">Book Now</a>
        </div>
    </div>
</div>
