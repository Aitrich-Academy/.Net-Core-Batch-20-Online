@page
@model CompanyManagement.Pages.Users.LoginModel
@{
	ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow rounded">
                <div class="card-header text-center">
                    <h4>Welcome to Company Management Portal</h4>
                    <h5 class="text-muted">Login</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger text-center">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="UserDto.Username" class="form-label">Username</label>
                            <input asp-for="UserDto.Username" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="UserDto.Password" class="form-label">Password</label>
                            <input asp-for="UserDto.Password" type="password" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Login</button>
                        <div class="text-center mt-3">
                            <span>Don't have an account?</span>
                            <a asp-page="/Users/Register" class="text-decoration-none">Sign up</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}