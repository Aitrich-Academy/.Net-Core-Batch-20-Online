@page
@model CompanyManagement.Pages.Members.EditModel
@{
    ViewData["Title"] = "Edit Member";
}
<h2>Edit Company Member</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div style="color:red">@Model.Message</div>
}

<form method="post">
    <input type="hidden" asp-for="MemberDto.Id" />
    <div class="form-group">
        <label>Name</label>
        <input asp-for="MemberDto.Name" class="form-control" />
    </div>
    <div class="form-group">
        <label>Position</label>
        <input asp-for="MemberDto.Position" class="form-control" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="MemberDto.Email" class="form-control" />
    </div>
    <div class="form-group">
        <label>Department</label>
        <input asp-for="MemberDto.Department" class="form-control" />
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}