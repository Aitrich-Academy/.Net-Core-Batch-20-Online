@page
@model CompanyManagement.Pages.Members.CreateModel
@{
	ViewData["Title"] = "Add Company Member";
}

<h2>Add Company Member</h2>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div style="color:red">@Model.Message</div>
}

<form method="post">

    <div class="form-group">
        <label>Name</label>
        <input asp-for="MemberDto.Name" class="form-control" />
    </div>
    <div class="form-group">
        <label>Position</label>
        <input asp-for="MemberDto.Position" class="form-control" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="MemberDto.Email" class="form-control" />
    </div>
    <div class="form-group">
        <label>Department</label>
        <input asp-for="MemberDto.Department" class="form-control" />
    </div>
  <br />
    <button type="submit" class="btn btn-primary">Add Member</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}