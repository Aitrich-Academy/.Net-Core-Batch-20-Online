@page
@model CompanyManagement.Pages.Members.IndexModel
@{
	ViewData["Title"] = "Company Members";
}
<a asp-page="Create" class="btn btn-primary mb-3">Add New Member</a>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Company Members</h3>
        </div>
        <div class="card-body">
            @if (Model.Members != null && Model.Members.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Position</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.Members)
                            {
                                <tr>
                                    <td>@member.Name</td>
                                    <td>@member.Position</td>
                                    <td>@member.Email</td>
                                    <td>@member.Department</td>
                                    <td>
                                        <a asp-page="Edit" asp-route-id="@member.Id" class="btn btn-warning btn-sm">Edit</a>
                                        <a asp-page="View" asp-route-id="@member.Id" class="btn btn-info btn-sm">View</a>
                                        <a asp-page="Delete" asp-route-id="@member.Id" class="btn btn-danger btn-sm">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center" role="alert">
                    No members found.
                </div>
            }
        </div>
    </div>
</div>