@page
@model UserManagement.Pages.Job.AppliedListModel
@{
    ViewData["Title"] = "My Applied Jobs";
}

<h2 class="mb-4">Jobs You Applied For</h2>

@if (Model.AppliedJobs != null && Model.AppliedJobs.Any())
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Job Title</th>
                <th>Company</th>
                <th>Location</th>
                <th>Applied Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.AppliedJobs)
            {
                <tr>
                    <td>@job.JobTitle</td>
                    <td>@job.Company</td>
                    <td>@job.Location</td>
                    <td>@job.PostedDate.ToShortDateString()</td> <!-- Using PostedDate as AppliedDate -->
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">You haven't applied for any jobs yet.</div>
}
