@page
@model BookLibrary.Pages.Books.ViewModel
@{
}

<h2>Book Details</h2>

@if (Model.Book != null)
{
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Book.id</dd>

        <dt class="col-sm-2">Book Title</dt>
        <dd class="col-sm-10">@Model.Book.Bookname</dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Model.Book.Author</dd>

        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Book.Price</dd>
        <a asp-page="Index" class="btn btn-secondary">Back</a>


    </dl>
}
else
{
    <p> not found.</p>
}
