@page
@model HospitalManagement.Pages.Doctor.EditModel
@{
}

    <h2>Edit Doctor</h2>

    <form method="post">
        <input type="hidden" asp-for="doctor.Id" />

    <div class="form-group">
        <label asp-for="doctor.Name" class="control-label"></label>
        <input asp-for="doctor.Name" class="form-control" />
        <span asp-validation-for="doctor.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="doctor.Qualification" class="control-label"></label>
        <input asp-for="doctor.Qualification" class="form-control" />
        <span asp-validation-for="doctor.Qualification" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="doctor.OP_Time" class="control-label"></label>
        <select asp-for="doctor.OP_Time" class="form-control">
            <option value="10am-12pm">10am-12pm</option>
            <option value="2pm-3pm">2pm-3pm</option>
            <option value="6pm-7pm">6pm-7pm</option>
        </select>
        <span asp-validation-for="doctor.OP_Time" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="doctor.Department" class="control-label"></label>
        <input asp-for="doctor.Department" class="form-control" />
        <span asp-validation-for="doctor.Department" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="doctor.Experience" class="control-label"></label>
        <input asp-for="doctor.Experience" class="form-control" />
        <span asp-validation-for="doctor.Experience" class="text-danger"></span>
    </div>






    <button type="submit" class="btn btn-primary mt-3">Save Changes</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

