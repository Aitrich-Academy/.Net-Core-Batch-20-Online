@page
@model HospitalManagement.Pages.Doctor.DeleteModel
@{
}


<h3>Are you sure you want to delete this Doctor?</h3>

<div>
    <h4>Doctor Details</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Doctor name</dt>
        <dd class="col-sm-10">@Model.Doctor.Name</dd>

        <dt class="col-sm-2">Qualification</dt>
        <dd class="col-sm-10">@Model.Doctor.Qualification</dd>

        <dt class="col-sm-2">Department</dt>
        <dd class="col-sm-10">@Model.Doctor.Department</dd>

        <dt class="col-sm-2">OP-Time</dt>
        <dd class="col-sm-10">@Model.Doctor.OP_Time</dd>

      
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Doctor.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

