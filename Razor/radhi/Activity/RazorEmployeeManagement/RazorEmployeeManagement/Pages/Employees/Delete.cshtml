@page "{id:int}"
@model RazorEmployeeManagement.Pages.Employees.DeleteModel
@{
}
<h2>Delete Employee</h2>
<p>Are you sure you want to delete this employee?</p>
<div>
    <strong>Name:</strong> @Model.Employee.Name
</div>
<div>
    <strong>Position:</strong> @Model.Employee.Position
</div>
<div>
    <strong>Salary:</strong> @Model.Employee.Salary
</div>
<div>
    <strong>Department:</strong> @Model.Employee.Department
</div>
<form method="post">
    <input type="hidden" asp-for="Employee.Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>


