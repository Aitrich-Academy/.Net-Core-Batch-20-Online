@page
@model WebApplication3.Pages.Students.ViewModel
@{
}


<h2>Student Details</h2>

@if (Model.Students != null)
{
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Students.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Students.Name</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Students.Age</dd>

        <dt class="col-sm-2">Cource</dt>
        <dd class="col-sm-10">@Model.Students.Course</dd>

      
    </dl>
}
else
{
    <p>Student not found.</p>
}

