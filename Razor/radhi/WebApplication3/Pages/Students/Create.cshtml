@page
@model WebApplication3.Pages.Students.CreateModel

@{
    ViewData["Title"] = "Student Registration";
}

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<div class="container mt-5">
    <h1 class="mb-4">Student Registration</h1>

    <form method="post" class="needs-validation" novalidate>

        <div class="mb-3">
            <label asp-for="Students.Name" class="form-label"></label>
            <input asp-for="Students.Name" class="form-control" />
            <span asp-validation-for="Students.Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Students.Age" class="form-label"></label>
            <input asp-for="Students.Age" class="form-control" />
            <span asp-validation-for="Students.Age" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Students.Course" class="form-label"></label>
            <input asp-for="Students.Course" class="form-control" />
            <span asp-validation-for="Students.Course" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


