@page "/Register"
@inject AuthService AuthService
@inject NavigationManager Navigation
@using SimpleAuthentication.Services


<h3>Register</h3>

<div>
    <label>Username</label>
    <input @bind="username" class="form-control"/>

    <label>Email</label>
    <input @bind="email" type="email" class="form-control"/>

    <label>Password</label>
    <input @bind="password" type="password" class="form-control"/>

    <button @onclick="RegisterUser" class="btn btn-success mt-2">Register</button>
    <br />
    <a href="/Login" @onclick="Loguser">Do you have account? Login</a>
</div>

@code {
    private string username;
    private string email;
    private string password;
    private string errorMessage;

    private async Task RegisterUser()
    {
   
        if (await AuthService.Register(username, password, email))
    {
        Navigation.NavigateTo("/login", forceLoad: true);
    }
        else
        {
            errorMessage = "Username already taken.";
        }
        }

    private async Task Loguser()
    {
        Navigation.NavigateTo("/Login");
    }

}
