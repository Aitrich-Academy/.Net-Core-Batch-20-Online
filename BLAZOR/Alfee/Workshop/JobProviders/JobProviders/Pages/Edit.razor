@page "/editjob/{id:int}"
@inject IJobService JobService
@inject NavigationManager Navigation
@inject ProtectedSessionStorage SessionStorage
@using JobProviders.Dto
@using JobProviders.Interface
@using Microsoft.AspNetCore.Components.Forms

<h3 class="text-center text-primary mt-4">Edit Job</h3>

@if (editingJob == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="card shadow p-4">
            <EditForm Model="editingJob" OnValidSubmit="UpdateJob">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label fw-bold">Title</label>
                    <InputText class="form-control" @bind-Value="editingJob.Title" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <InputText class="form-control" @bind-Value="editingJob.Description" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Location</label>
                    <InputText class="form-control" @bind-Value="editingJob.Location" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Salary</label>
                    <InputNumber class="form-control" @bind-Value="editingJob.Salary" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Update Job
                    </button>
                    <button class="btn btn-secondary ms-2" @onclick="Cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int id { get; set; }

    private JobDto editingJob;

    protected override async Task OnInitializedAsync()
    {
        var sessionResult = await SessionStorage.GetAsync<int>("JobProviderId");

        if (!sessionResult.Success)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        editingJob = await JobService.GetJobByIdAsync(id);
        if (editingJob == null)
        {
            Navigation.NavigateTo("/joblist");
        }
    }

    private async Task UpdateJob()
    {
        await JobService.UpdateJobAsync(editingJob);
        Navigation.NavigateTo("/joblist");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/joblist");
    }
}
