@page
@model LibrarySystem.Pages.Library.RegisterModel
@{


    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="border rounded p-4 shadow" style="min-width: 350px;">
            <h2 class="text-center mb-4">Registration</h2>

            <form method="post">
                <!-- Username -->
                <div class="form-group">
                    <label asp-for="NewUser.Username"></label>
                    <input asp-for="NewUser.Username" class="form-control" required />
                    <span asp-validation-for="NewUser.Username" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label asp-for="NewUser.Password"></label>
                    <input asp-for="NewUser.Password" type="password" class="form-control" required />
                    <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                </div>

                <!-- Role -->
                <div class="form-group">
                    <label asp-for="NewUser.Role"></label>
                    <select asp-for="NewUser.Role" class="form-control" required>
                        <option value="">-- Select Role --</option>
                        <option>Admin</option>
                        <option>User</option>
                        <option>Manager</option>
                    </select>
                    <span asp-validation-for="NewUser.Role" class="text-danger"></span>
                </div>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <button type="submit" class="btn btn-primary btn-block">Register</button>
            </form>

            <p class="text-center mt-3">
                <a asp-page="/MyUser/Login">Already have an account? Login</a>
            </p>
        </div>
    </div>

  
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />

    }
}
