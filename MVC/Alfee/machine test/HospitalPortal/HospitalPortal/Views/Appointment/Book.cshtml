@model HospitalPortal.Dtos.AppointmentDto

<h2>Book Appointment</h2>

<form asp-action="Book" method="post">
    <label>Patient Id</label>
    <input asp-for="PatientId" /><br />

    <label>Doctor Id</label>
    <input asp-for="DoctorId" /><br />

    <label>Date</label>
    <input asp-for="AppointmentDate" type="date" /><br />

    <button type="submit">Book</button>
</form>