@model JobPortalMVC.Models.Job

@{
    ViewData["Title"] = "Job Details";
}

<div class="container py-4 d-flex justify-content-center">
    <div class="card border-primary shadow mb-4 w-75" style="max-width: 30rem;">
        <div class="card-header bg-primary text-white">
            <h4 class="card-title mb-0">@Model.Title</h4>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-sm-4 text-muted">Company:</div>
                <div class="col-sm-8">@Model.Company</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted">Location:</div>
                <div class="col-sm-8">@Model.Location</div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-4 text-muted">Salary:</div>
                <div class="col-sm-8">@Model.Salary.ToString()</div>
            </div>
            <hr />
            <p class="text-muted mb-1">Description:</p>
            <p>@Model.Description</p>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Index" class="btn btn-outline-primary">Back to List</a>
        </div>
    </div>
</div>

