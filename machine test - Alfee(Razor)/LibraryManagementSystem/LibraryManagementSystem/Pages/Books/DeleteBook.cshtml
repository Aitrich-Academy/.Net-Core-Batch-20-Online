@page
@model LibraryManagementSystem.Pages.Books.DeleteBookModel
@{
	ViewData["Title"] = "Delete Book";
}

<h2>Confirm Delete</h2>

<form method="post">
    <p>Are you sure you want to delete <strong>@Model.Book?.Title</strong>?</p>
    <input type="hidden" asp-for="Book.Id" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-page="Index" asp-route-role="admin" class="btn btn-secondary">Cancel</a>
</form>